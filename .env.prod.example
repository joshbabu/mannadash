# Copy this file to .env on the server and fill in real values.
# This file itself should stay as placeholders only — never commit real secrets.

DB_PASSWORD=change_this_to_a_long_random_password

JWT_SECRET=change_this_to_a_long_random_string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Leave blank until you have real Razorpay keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
