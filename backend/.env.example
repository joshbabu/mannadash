DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app
DB_PASSWORD=app_local_dev_password
DB_NAME=hyd_food_delivery

JWT_SECRET=change_this_to_a_long_random_string_before_production

# Single admin account for approving restaurants/riders — change these before deploying anywhere real
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Menu item photos — a separate PUBLIC bucket from your private backups bucket
R2_MENU_IMAGES_BUCKET=mannadash-menu-images
R2_MENU_IMAGES_PUBLIC_URL=

# Web push notifications — generate your own pair with: npx web-push generate-vapid-keys
# (never reuse keys shown in a chat/tutorial — generate fresh ones for your real deployment)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Auto-fetched default menu photos — free tier, sign up at unsplash.com/developers
# Leave blank to fall back to Wikimedia Commons (lower quality but needs no key)
UNSPLASH_ACCESS_KEY=
